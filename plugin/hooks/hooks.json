{
  "description": "Lets iFixAi's own steps run without a permission prompt: iFixAi's tools, and only the exact commands they hand out. Anything else asks as usual.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_ifixai_ifixai__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"An iFixAi tool\"}}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-ifixai-commands.mjs\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
